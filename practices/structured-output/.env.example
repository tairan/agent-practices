# Mode resolution (see README heading "真实模型模式 vs 离线测试模式"):
#   未设 → 安全默认 mock，即使环境中存在 GEMINI_API_KEY
#   mock → 强制 mock(任何环境都跑通)
#   real → 强制 real,无 key 时立即退出 1
# STRUCTURED_OUTPUT_MODE=

# 仅当 STRUCTURED_OUTPUT_MODE=real 时使用 KEY。
GEMINI_API_KEY=
# API key 固定发送到 Google 官方 HTTPS endpoint，base URL 不可配置。
GEMINI_MODEL_FAMILY=gemini-3.5-flash

# HTTP 超时(秒)，仅接受 1..=120；非法值使 real 模式拒绝启动。
GEMINI_TIMEOUT_SECS=30
