# Mode resolution (see README §9):
#   未设 → 按 GEMINI_API_KEY 是否存在自动选择
#   mock → 强制 mock(任何环境都跑通)
#   real → 强制 real,无 key 时立即退出 1
# STRUCTURED_OUTPUT_MODE=

# 提供 KEY 时 demo 自动走 real;留空 fallback 到 mock 并 stderr 提示
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_FAMILY=gemini-3.5-flash

# HTTP 超时(秒)
GEMINI_TIMEOUT_SECS=30
